{
  "name": "prechess",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @prechess/worker dev",
    "build": "pnpm --filter @prechess/shared build && pnpm --filter @prechess/worker build",
    "lint": "pnpm --filter @prechess/shared lint && pnpm --filter @prechess/worker lint",
    "typecheck": "pnpm --filter @prechess/shared typecheck && pnpm --filter @prechess/worker typecheck",
    "clean": "pnpm --filter @prechess/shared clean && pnpm --filter @prechess/worker clean"
  }
}
